{
  "name": "scroll-guard",
  "version": "0.3.0",
  "private": true,
  "homepage": "https://github.com/tameravci/scroll-guard#readme",
  "repository": { "type": "git", "url": "git+https://github.com/tameravci/scroll-guard.git" },
  "bugs": { "url": "https://github.com/tameravci/scroll-guard/issues" },
  "description": "Chrome extension that flags AI slop, clickbait, bot spam, and scams in your X feed with TypeSafe Jev.",
  "scripts": {
    "check": "node scripts/check-extension.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "package": "node scripts/package-extension.mjs",
    "test": "node tests/run-tests.js && node tests/jev.test.js",
    "test:live": "node --env-file=.env scripts/test-jev-live.mjs",
    "test:browser": "node scripts/test-jev-browser.mjs",
    "test:browser:live": "JEV_BROWSER_LIVE=1 node --env-file=.env scripts/test-jev-browser.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
